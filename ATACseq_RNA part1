################################################################################
# 3. ATAC-seq: DIFFERENTIAL ACCESSIBILITY WITH DESeq2 (d1 vs d0)
################################################################################

# 1. Add a peak_id column - here simply the row index
Consensus_H <- Consensus_H %>%
  mutate(peak_id = row_number())

# 2. Select the count columns and build the count matrix
# Counts are assumed to be all columns whose names contain "Ind" and end with "d0" or "d1"
count_cols <- grep("^Ind.*d[01]$", colnames(Consensus_H), value = TRUE)

count_data <- Consensus_H %>% select(all_of(count_cols))
count_data <- round(count_data)
rownames(count_data) <- Consensus_H$peak_id

# 3. Build the metadata table (colData) - group is 'd0' or 'd1'
# The day is extracted from the column name suffix
coldata <- data.frame(
  sample = colnames(count_data),
  condition = ifelse(grepl("d0$", colnames(count_data)), "d0", "d1")
)
rownames(coldata) <- coldata$sample

# 4. Create the DESeqDataSet object
dds <- DESeqDataSetFromMatrix(countData = count_data,
                              colData = coldata,
                              design = ~ condition)

# 5. Run DESeq2
dds <- DESeq(dds)

# 6. Extract results for the d1 vs d0 comparison
res <- results(dds, contrast = c("condition", "d1", "d0"))

# 7. Add the results to the original data frame
res_df <- as.data.frame(res)
res_df$peak_id <- rownames(res_df)

Consensus_H <- left_join(Consensus_H, res_df, by = "peak_id")

# Consensus_H now contains the test result columns (log2FoldChange, pvalue, padj, etc.)


